APP_ENV=development
# Use all only for local development. Deploy api, worker, ai-worker, and
# maintenance as separate process roles.
PROCESS_ROLE=all
HTTP_ADDR=:8200
# Per-API-instance long-lived stream budget. Provision the process/ingress file
# descriptor and memory limits for at least this many sockets plus headroom.
SSE_MAX_CONNECTIONS=10000
SSE_MAX_CONNECTIONS_PER_IP=40
PAYMENT_SSE_MAX_CONNECTIONS_PER_TOKEN=6
CLIENT_PUBLIC_BASE_URL=http://localhost:5275
MARKETPLACE_PUBLIC_BASE_URL=http://localhost:5375
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking?sslmode=disable
# Ordinary query/transaction pool. This URL may target PgBouncer transaction
# mode only after the direct pool below is configured and verified.
DATABASE_MAX_CONNECTIONS=14
DATABASE_MIN_CONNECTIONS=2
# Direct PostgreSQL URL for LISTEN and maintenance leadership. It defaults to
# DATABASE_URL locally. Never point this value at PgBouncer transaction mode.
DATABASE_DIRECT_URL=
# Exact defaults: api=3 (4 with Tessa), worker=1, ai-worker=1,
# maintenance=1, all=6 (7 with Tessa).
DATABASE_DIRECT_MAX_CONNECTIONS=6
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_LIFETIME_JITTER=5m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=30s
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=30s
DATABASE_LOCK_TIMEOUT=5s
DATABASE_IDLE_TRANSACTION_TIMEOUT=30s
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5275,http://127.0.0.1:5275
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Required to scrape GET /internal/metrics. Generate a separate high-entropy operational token.
METRICS_AUTH_TOKEN=
HTTP_SUCCESS_LOG_SAMPLE_RATE=0.1
HTTP_SLOW_REQUEST_THRESHOLD=750ms
AUTH_ISSUER=booking-api
AUTH_ACCESS_TOKEN_SECRET=replace-this-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_ACCESS_COOKIE_NAME=booking_access
AUTH_REFRESH_COOKIE_NAME=booking_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_BCRYPT_COST=12
AUTH_EMAIL_ENABLED=false
# Advertise and send WhatsApp auth only after `make auth-whatsapp-template-conformance`
# and an authorized real-recipient send/verification test pass in this environment.
AUTH_WHATSAPP_ENABLED=false
# B1 linking only. Ordinary Tessa WhatsApp conversations remain unavailable.
# Tessa connection security notices use AUTH_EMAIL_ENABLED and the existing auth SMTP worker,
# independently of NOTIFICATION_EMAIL_ENABLED. Pending notices expire after 24 hours.
TESSA_WHATSAPP_LINKING_ENABLED=false
# Separate chat rollout/kill switch: linking alone must not enable private AI replies.
TESSA_WHATSAPP_CONVERSATIONS_ENABLED=false
AUTH_DELIVERY_CONCURRENCY=4
AUTH_DELIVERY_TIMEOUT=30s
# JSON map of key version to a base64-encoded 32-byte AES key.
AUTH_DELIVERY_ENCRYPTION_KEYS=
AUTH_DELIVERY_ACTIVE_KEY=
# Separate high-entropy secret; do not reuse the notification HMAC key.
AUTH_DESTINATION_HMAC_KEY=
R2_PRIVATE_BUCKET_NAME=
# Public images use versioned object keys and this CDN origin. Configure both values together.
R2_PUBLIC_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_BASE_URL=
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Booking
SMTP_SECURITY=tls
SMTP_INSECURE_SKIP_VERIFY=false
SMTP_CONNECT_TIMEOUT=10s
# Booking notification rollout gates. Enable email only after SMTP sandbox/inbox
# acceptance is certified for the deployment environment.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=false
WHATSAPP_WORKER_CONCURRENCY=4
NOTIFICATION_PLANNER_CONCURRENCY=4
NOTIFICATION_EMAIL_CONCURRENCY=4
NOTIFICATION_EMAIL_TIMEOUT=30s
WELCOME_EMAIL_ENABLED=false
WELCOME_EMAIL_CONCURRENCY=2
WELCOME_EMAIL_TIMEOUT=30s
WHATSAPP_ENABLED_TEMPLATE_KEYS=
# Use separate high-entropy values for verification and destination HMACs.
NOTIFICATION_DESTINATION_HMAC_KEY=
# API webhook identity and verification. META_APP_ID is used for operational
# subscription checks; the webhook runtime itself does not need WABA_TOKEN.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WABA_PHONE_NUMBER_ID=
WABA_BUSINESS_PHONE_E164=
# Outbound worker/conformance credential. Generate the system-user token for
# the intended Meta app and assign that system user access to the WABA.
WABA_TOKEN=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_HTTP_TIMEOUT=15s
PAYSTACK_SECRET_KEY=
PAYSTACK_SECRET_KEY_TEST=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYAZA_PUBLIC_KEY=
PAYAZA_SECRET_KEY=
PAYAZA_PUBLIC_KEY_TEST=
PAYAZA_SECRET_KEY_TEST=
PAYAZA_BASE_URL=https://api.payaza.africa/live
PAYAZA_TRANSFER_PIN=
PAYAZA_TRANSFER_PIN_TEST=
PAYAZA_SOURCE_ACCOUNTS='{"NGN":"source-account-reference"}'
PAYAZA_SOURCE_ACCOUNTS_TEST='{"NGN":"test-source-account-reference"}'
PAYAZA_PAYOUT_SENDER_NAME=
PAYAZA_PAYOUT_SENDER_PHONE=
PAYAZA_PAYOUT_SENDER_ADDRESS=
PAYAZA_NGN_DVA_BANK_CODE=
PAYAZA_NGN_DVA_ENQUIRY_BANK_CODE=
PAYAZA_CARD_SANDBOX_VERIFIED=false
PAYAZA_CARD_PRODUCTION_ENABLED=false
PAYAZA_BANK_TRANSFER_SANDBOX_VERIFIED=false
PAYAZA_BANK_TRANSFER_PRODUCTION_ENABLED=false
PAYAZA_DESTINATION_SANDBOX_VERIFIED=false
PAYAZA_DESTINATION_PRODUCTION_ENABLED=false
PAYAZA_PAYOUT_SANDBOX_VERIFIED=false
PAYAZA_PAYOUT_PRODUCTION_ENABLED=false
PAYSTACK_CARD_SANDBOX_VERIFIED=false
PAYSTACK_CARD_PRODUCTION_ENABLED=false
PAYSTACK_BANK_TRANSFER_SANDBOX_VERIFIED=false
PAYSTACK_BANK_TRANSFER_PRODUCTION_ENABLED=false
PAYSTACK_DESTINATION_SANDBOX_VERIFIED=false
PAYSTACK_DESTINATION_PRODUCTION_ENABLED=false
PAYSTACK_PAYOUT_SANDBOX_VERIFIED=false
PAYSTACK_PAYOUT_PRODUCTION_ENABLED=false
PAYSTACK_PAYOUT_OTP_DISABLED=false
PAYMENT_CERTIFICATION_NGN_ACCOUNT_NUMBER=
PAYMENT_CERTIFICATION_MAX_AMOUNT_MINOR=10000
PAYMENTS_ENVIRONMENT=test
FINANCIAL_DATA_ENCRYPTION_KEYS=
FINANCIAL_DATA_ACTIVE_KEY_VERSION=
FINANCIAL_DATA_FINGERPRINT_KEY=
AGREEMENT_TOKEN_ENCRYPTION_KEYS=
AGREEMENT_TOKEN_ACTIVE_KEY=
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
# AI task routing
DEFAULT_AI_PROVIDER=self_hosted
AGREEMENT_AI_PROVIDER=hosted
INBOX_AI_DRAFTS_ENABLED=false
INBOX_AI_PROVIDER_ALLOWLIST=
# Live semi-pilot is opt-in and restricted to explicit provider IDs.
INBOX_AI_AUTOMATION_ENABLED=false
INBOX_AI_AUTOMATION_PROVIDER_ALLOWLIST=
# Per ai-worker process and shared by Tessa plus inbox model jobs. Size the
# ai-worker deployment concurrency as the cluster budget; inference does not
# hold a database connection.
INBOX_AI_MAX_CONCURRENCY=2
INBOX_AI_SEMI_PILOT_REPLY_DELAY=800ms
INBOX_AI_AUTOPILOT_PAYMENT_WINDOW=30m
# Provider-facing Tessa assistant. When enabled, available to authenticated providers.
TESSA_AI_ENABLED=false
TESSA_AI_PRIMARY_PROVIDER=self_hosted
# hosted, openai_compatible, or blank. External fallback requires the approval flag below.
TESSA_AI_FALLBACK_PROVIDER=
TESSA_AI_EXTERNAL_PROCESSING_APPROVED=false
TESSA_AI_PRIMARY_REQUEST_TIMEOUT=30s
TESSA_AI_FALLBACK_REQUEST_TIMEOUT=20s
TESSA_AI_TURN_TIMEOUT=75s
TESSA_AI_WORKER_CONCURRENCY=2
TESSA_AI_MAX_INPUT_TOKENS=12000
TESSA_AI_MAX_OUTPUT_TOKENS=1600
TESSA_AI_NOTICE_REVISION=2026-08-30
# Opt-in rollout gates. Model, sampling, input/output, and timeout settings come
# from the same Tessa/LLM variables used by the running API.
TESSA_LOCAL_CAPACITY_CONCURRENCY=2
TESSA_LOCAL_CAPACITY_REQUESTS=6
TESSA_LOCAL_CAPACITY_MAX_P95=45s
# Self-hosted OpenAI-compatible inference server
LLM_BASE_URL=http://127.0.0.1:7080
LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT=30s
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.2
TOP_P=0.9
TOP_K=40
MIN_P=0.1
PRESENCE_PENALTY=0
REPETITION_PENALTY=1.0
SELF_HOSTED_THINKING=false

# Hosted AI used by tasks routed to hosted
HOSTED_AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT=120s
OPENAI_MAX_OUTPUT_TOKENS=16000
OPENAI_RESPONSE_LOG_FILE=

# External OpenAI-compatible Chat Completions endpoint. Required only when
# DEFAULT_AI_PROVIDER or AGREEMENT_AI_PROVIDER is openai_compatible.
OPENAI_COMPAT_BASE_URL=https://models.example.com
OPENAI_COMPAT_CHAT_COMPLETIONS_PATH=/v1/chat/completions
OPENAI_COMPAT_MODEL=model-name
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_TIMEOUT=60s
OPENAI_COMPAT_MAX_OUTPUT_TOKENS=1600
# Use exactly one of max_tokens or max_completion_tokens for the endpoint.
OPENAI_COMPAT_TOKEN_LIMIT_FIELD=max_tokens
# Leave both blank to omit sampling controls; configure at most one.
OPENAI_COMPAT_TEMPERATURE=
OPENAI_COMPAT_TOP_P=
GOOGLE_MAPS_SERVER_API_KEY=
HTTP_IDLE_TIMEOUT=60s
HTTP_RATE_LIMIT_PER_MINUTE=300
HTTP_RATE_LIMIT_BURST=100
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_BURST=4
LOCATION_RATE_LIMIT_PER_MINUTE=20
LOCATION_RATE_LIMIT_BURST=5
MARKETPLACE_AUTH_RATE_LIMIT_PER_MINUTE=20
MARKETPLACE_AUTH_RATE_LIMIT_BURST=6

# Replica-shared ephemeral state. rediss:// enables TLS. The key prefix must be
# unique per environment and is versioned so cache formats can be rolled safely.
# Development may leave REDIS_URL blank; the production API role requires it.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=tellbook:development:v1
# Secret used to HMAC dynamic Redis key segments; use at least 32 random bytes.
REDIS_KEY_HMAC_SECRET=replace-with-at-least-32-random-bytes
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNECTIONS=4
REDIS_DIAL_TIMEOUT=750ms
REDIS_READ_TIMEOUT=250ms
REDIS_WRITE_TIMEOUT=250ms
REDIS_POOL_TIMEOUT=500ms
REDIS_MAX_PAYLOAD_BYTES=65536
REDIS_FALLBACK_MAX_CONCURRENCY=32
# Secondary source-IP ceiling; actor/identifier remains the primary limiter.
RATE_LIMIT_IP_CEILING_MULTIPLIER=8

# Additional security, financial and booking emails; no historical backfill.
ADDITIONAL_EMAILS_ENABLED=false

# Dedicated platform staff API. Disabled until admin migrations and HTTPS app are ready.
ADMIN_ENABLED=false
ADMIN_PUBLIC_URL=
# JSON object of key versions to base64-encoded 32-byte AES keys; keep old keys during rotation.
ADMIN_MFA_ENCRYPTION_KEYS=
ADMIN_MFA_ACTIVE_KEY=
